# Claude Code local config of contributors (not part of noeta)
.claude/

# Live-test secrets (never committed)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.tox/
htmlcov/
.coverage
.coverage.*
dist/
build/
site/
*.egg
node_modules/

# a plugin's built web part is what gets installed (examples/web-panel)
!examples/*/web/dist/

# web/ test output
web/test-results/
web/playwright-report/

# desktop/ build and test output
desktop/build/
desktop/release/
desktop/test-results/
desktop/playwright-report/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local demo / scratch artifacts
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.tmp.xml
*.tmp

# Local host config that may hold an api_key — ignored so a local copy can
