  "cards": [
    {
      "dot": "emerald",
      "title": "One turn, one lease",
      "items": [
        "run_one_step returns at the next suspend or terminal, not before",
        "A tool_calls Decision loops in place: append results, recompose, ask again",
        "Segment 02 repeats until the Policy stops asking for tools"
      ]
    },
    {
      "dot": "cyan",
      "title": "Recorded before it counts",
      "items": [
        "ContextPlanComposed records exactly what went into each LLM call",
        "Parallel tool results land as one batched MessagesAppended event",
        "Replaying the stream folds back to the same state — no hidden memory"
      ]
    },
    {
      "dot": "violet",
      "title": "Provider-neutral by construction",
      "items": [
        "The Engine speaks one LLMProvider protocol and nothing vendor-specific",
        "Anthropic, OpenAI-compatible and Responses adapters are built-in plugins",
        "The kernel never imports a vendor SDK — the loader resolves adapters by ref"
      ]
    }
  ]
}
