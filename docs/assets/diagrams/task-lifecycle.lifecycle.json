{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Task lifecycle",
    "subtitle": "pending → running → suspended → terminal; one suspended status, four wake conditions",
    "output": "task-lifecycle.html",
    "viewBox": [980, 700]
  },
  "lanes": [
    { "id": "main", "label": "Task status" },
    { "id": "waiting", "label": "Wake conditions" },
    { "id": "terminal", "label": "Terminal events" }
  ],
  "states": [
    { "id": "pending", "type": "start", "label": "Pending", "sublabel": "queued for a lease", "lane": "main", "col": 0, "step": "01" },
    { "id": "running", "type": "active", "label": "Running", "sublabel": "compose/decide/dispatch", "lane": "main", "col": 1, "step": "02", "tag": "a Worker holds the lease" },
    { "id": "suspended", "type": "waiting", "label": "Suspended", "sublabel": "wake_on is set", "lane": "main", "col": 2, "step": "03", "tag": "no thread, no memory" },

    { "id": "w_human", "type": "waiting", "label": "Human answer", "sublabel": "HumanResponseReceived", "lane": "waiting", "col": 1, "height": 44 },
    { "id": "w_timer", "type": "waiting", "label": "Timer fired", "sublabel": "TimerFired", "lane": "waiting", "col": 2, "height": 44 },
    { "id": "w_subtask", "type": "waiting", "label": "Subtask done", "sublabel": "SubtaskCompleted", "lane": "waiting", "col": 1, "height": 44, "yOffset": 56 },
    { "id": "w_external", "type": "waiting", "label": "External event", "sublabel": "ExternalEvent", "lane": "waiting", "col": 2, "height": 44, "yOffset": 56 },

    { "id": "completed", "type": "success", "label": "Completed", "sublabel": "TaskCompleted", "lane": "terminal", "col": 0 },
    { "id": "failed", "type": "failure", "label": "Failed", "sublabel": "TaskFailed", "lane": "terminal", "col": 1 },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "TaskCancelled", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "from": "pending", "to": "running", "variant": "emphasis", "route": "straight", "fromSide": "right", "toSide": "left" },
    { "from": "running", "to": "suspended", "variant": "emphasis", "route": "straight", "fromSide": "right", "toSide": "left" },
    { "from": "suspended", "to": "running", "label": "wake", "variant": "emphasis", "route": "top-channel", "channelY": 96, "fromSide": "top", "toSide": "top" },
    { "from": "running", "to": "completed", "label": "finish", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "via": [[248, 414], [402, 414]], "labelSegment": 1 },
    { "from": "running", "to": "failed", "label": "fail", "variant": "security", "fromSide": "bottom", "toSide": "top", "via": [[248, 392], [556, 392]], "labelSegment": 1 },
    { "from": "suspended", "to": "cancelled", "label": "cancel", "variant": "security", "route": "right-channel", "fromSide": "right", "toSide": "right", "labelSegment": 1 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One suspended status",
      "items": [
        "Waiting on a human, a timer, a subtask or an external source is the same status",
        "wake_on carries the typed WakeCondition; matches_wake is the only matcher",
        "A fan-out join waits on SubtaskGroupCompleted through the same mechanism"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable exactly-once wake",
      "items": [
        "The Dispatcher holds the matched wake event; leasing does not consume it",
        "release(consumed_wake_event=...) clears it only after TaskWoken is durable",
        "At-least-once delivery plus idempotent consumption is exactly-once"
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal is a status, not one event",
      "items": [
        "TaskCompleted, TaskFailed and TaskCancelled all fold to status terminal",
        "A TaskSnapshot is written ahead of each suspend and each terminal exit",
        "ConversationClosed only archives: the Task stays suspended and reopenable"
      ]
    }
  ]
}
