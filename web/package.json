{
  "name": "noeta-web",
  "private": true,
  "version": "0.1.0",
  "description": "The noeta web app: sessions, transcript, approvals and the composer over noeta serve's HTTP API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "build:packages": "npm run build -w sdk && npm run build -w ui"
  },
  "workspaces": [
    "sdk",
    "ui"
  ],
  "dependencies": {
    "@initxy/noeta-ui": "1.0.6",
    "@initxy/noeta-web-sdk": "1.0.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "~1.58.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
