# Copy to deploy/.env (git-ignored) and fill in. deploy/compose.yaml reads it.

# The model every task starts on, and its provider (anthropic, the default;
# openai_compat; openai_responses). docs/guides/models.md lists the choices.
NOETA_MODEL=claude-sonnet-5-5
NOETA_PROVIDER=
NOETA_BASE_URL=
NOETA_API_KEY=

# The bearer token clients send to noeta serve (Authorization: Bearer ...).
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NOETA_SERVER_TOKEN=

# The Postgres password, used only inside the compose network.
POSTGRES_PASSWORD=

# How many worker containers, and where the API listens on the Docker host
# (127.0.0.1 only by default; 0.0.0.0:8642 to reach it from other machines).
NOETA_WORKERS=3
NOETA_PORT=127.0.0.1:8642
