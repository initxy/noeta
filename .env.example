# Live LLM test configuration.
#
# Copy this file to `.env` (git-ignored) to run the live tests:
#
#     cp .env.example .env      # then fill in the values below
#     uv run pytest -m live
#
# One gateway, one key, one base — three endpoints exercised:
#   /v1/messages          (Anthropic-shape adapter)
#   /v1/responses         (OpenAI Responses adapter)
#   /v1/chat/completions  (OpenAI-compat adapter)
#
# Missing any of base/key/model auto-skips every live test (CI never runs them).
# An already-set environment variable overrides the file, so you can also do:
#   NOETA_LIVE_MODEL=other-model uv run pytest -m live

NOETA_LIVE_BASE_URL=https://your-gateway.example.com
NOETA_LIVE_API_KEY=your-rotated-key
NOETA_LIVE_MODEL=your-model-id

# Optional:
# NOETA_LIVE_MAX_TOKENS=1024
# A vision-capable model for the image chain; falls back to NOETA_LIVE_MODEL.
# NOETA_LIVE_VISION_MODEL=your-vision-capable-model
