; Noeta import-linter contracts.
;
; Enforces the layering across the two-package topology
; (noeta-runtime / noeta-sdk). Both distributions contribute subpackages to
; the shared PEP 420 ``noeta`` namespace, so the contracts run on import
; *paths*, which stay invariant while the physical distribution boundary
; moves. ``protocols`` is the typed boundary (L0) and must not depend on any
; other in-project module; ``core`` (L1) may depend on ``protocols`` only.
;
; Microkernel layer table (M4 redraw). noeta-runtime is a pure kernel: the
; kernel-services band (runtime / storage / observers / read_models), the
; materials band above it (context — the locked composer + registries;
; policies — phase 2; tools — authoring machinery only, every capability
; impl moved out), and ``execution`` (the injection-only session builder).
; noeta-sdk carries ``client`` (SDK core — the assembly boundary that
; injects the parts), ``presets`` / ``builtins`` (top-of-stack content: the
; built-in plugin catalogue holds every official capability impl), and the
; ``noeta.sdk`` façade. The old guards / providers / tool-pack
; implementation bands are gone — they live inside ``noeta.builtins.*.impl``
; and are reachable ONLY through the loader's dynamic ``ref`` doorway
; (``sdk-core-not-builtins`` below is the universal static ban, which is
; also what keeps kernel↛adapter: ``noeta.runtime`` can never statically
; import the provider / backend adapters, because they all live in
; ``noeta.builtins``). The ``noeta.agent`` identity layer (``spec`` /
; ``registry``) ships in the library wheels; product hosts live in their own
; repositories and drive the engine only through ``noeta.sdk`` (the
; engine-behaviour suite assembles via ``noeta.sdk.Client``, tests/_sdk_session).

[importlinter]
root_package = noeta
; Engine lazily imports ToolRuntime as a wiring convenience when callers
; do not pass one explicitly; the edge is intentional and documented in
; core/engine.py. The library-SDK refactor removed the old composer default, so the
; kernel no longer reaches into noeta.context at all.
include_external_packages = False

[importlinter:contract:layers]
name = Noeta layering (materials band split from kernel-services)
type = layers
layers =
    noeta.sdk
    noeta.builtins | noeta.presets
    noeta.client
    noeta.execution
    noeta.context | noeta.policies | noeta.tools
    noeta.runtime | noeta.storage | noeta.observers | noeta.read_models
    noeta.agent.registry
    noeta.agent.spec
    noeta.core
    noeta.protocols
exhaustive = false
ignore_imports =
    noeta.core.engine -> noeta.runtime.tool

[importlinter:contract:protocols-isolation]
name = noeta.protocols must not import any other in-project module
type = forbidden
source_modules =
    noeta.protocols
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.observers
    noeta.agent

[importlinter:contract:core-uses-only-protocols]
name = noeta.core may only import noeta.protocols (no L2 deps)
type = forbidden
source_modules =
    noeta.core
forbidden_modules =
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.observers
    noeta.agent
ignore_imports =
    ; The Engine lazily imports ``noeta.runtime.tool.ToolRuntime`` only when
    ; the caller did not wire one explicitly. A runtime convenience, not a
    ; module-load-order dependency, but import-linter sees the string so we
    ; mark it as the intentional exception. The library-SDK refactor removed
    ; the old ``noeta.context.composer`` default — the kernel no longer reaches there.
    noeta.core.engine -> noeta.runtime.tool

[importlinter:contract:sdk-core-not-presets]
name = SDK core must not import noeta.presets (presets is top-of-stack factory content, only consumers import it)
type = forbidden
source_modules =
    noeta.client
    noeta.execution
    noeta.context
    noeta.policies
    noeta.tools
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.presets

[importlinter:contract:sdk-core-not-builtins]
name = Nothing statically imports noeta.builtins (universal, microkernel D2 — built-in plugins are reached only by ref; the loader imports them dynamically)
type = forbidden
source_modules =
    noeta.client
    noeta.execution
    noeta.context
    noeta.policies
    noeta.tools
    noeta.runtime
    noeta.storage
    noeta.observers
    noeta.read_models
    noeta.core
    noeta.protocols
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.builtins

[importlinter:contract:kernel-vocabulary-diet]
name = kernel vocabulary modules (runtime.{governance,mcp}) import only noeta.protocols (microkernel M2/M3 sinks stay pure config/protocol vocabulary; phase 3 moved runtime.{browser,app_preview} into their plugins)
type = forbidden
source_modules =
    noeta.runtime.governance
    noeta.runtime.mcp
forbidden_modules =
    noeta.core
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.observers
    noeta.read_models
    noeta.execution
    noeta.agent
    noeta.client
    noeta.sdk
    noeta.presets

[importlinter:contract:agent-only-protocols]
name = noeta.agent identity layer (spec/registry) may only import noeta.protocols (narrowed to the identity submodules — the rest of the noeta.agent namespace is product content)
type = forbidden
source_modules =
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.observers
    noeta.read_models

[importlinter:contract:observers-only-protocols]
name = noeta.observers may only import noeta.protocols (issue 19)
type = forbidden
source_modules =
    noeta.observers
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools

[importlinter:contract:read-models-isolated]
name = noeta.read_models may only import noeta.protocols + noeta.core.fold (CW5a)
type = forbidden
source_modules =
    noeta.read_models
forbidden_modules =
    noeta.runtime
    noeta.context
    noeta.policies
    noeta.tools
    noeta.observers
    noeta.storage
    noeta.core
; ``noeta.core`` is forbidden wholesale so read_models cannot reach
; engine/wiring/observers; the ONE allowed core edge — the fold projection —
; is whitelisted precisely (CW5a P1: lock the boundary, don't leave core open).
ignore_imports =
    noeta.read_models.tasks -> noeta.core.fold

[importlinter:contract:storage-adapters-isolated]
name = production code talks to storage Protocols, never to InMemory adapters
type = forbidden
source_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.policies
    noeta.tools
    noeta.protocols
forbidden_modules =
    noeta.storage

