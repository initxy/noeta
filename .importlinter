; Noeta import-linter contracts.
;
; Enforces the layering across the two-package topology
; (noeta-runtime / noeta-sdk). Both distributions contribute subpackages to
; the shared PEP 420 ``noeta`` namespace, so the contracts run on import
; *paths*, which stay invariant while the physical distribution boundary
; moves. ``protocols`` is the typed boundary (L0) and must not depend on any
; other in-project module; ``core`` (L1) may depend on ``protocols`` only.
; The library-SDK layering splits the old L2 band by mechanism vs material:
; the kernel-services band (runtime / storage / guards / observers /
; read_models — noeta-runtime) sits below the SDK **materials** band (context
; / policies / tools / providers — noeta-sdk), so a kernel service can never
; import a material. The ``noeta.agent`` identity layer (``spec`` /
; ``registry``) ships in the library wheels; product hosts live in their own
; repositories and drive the engine only through ``noeta.sdk`` (the
; engine-behaviour suite assembles via ``noeta.sdk.Client``, tests/_sdk_session).

[importlinter]
root_package = noeta
; Engine lazily imports ToolRuntime as a wiring convenience when callers
; do not pass one explicitly; the edge is intentional and documented in
; core/engine.py. The library-SDK refactor removed the old composer default, so the
; kernel no longer reaches into noeta.context at all.
include_external_packages = False

[importlinter:contract:layers]
name = Noeta layering (materials band split from kernel-services)
type = layers
layers =
    noeta.sdk
    noeta.builtins | noeta.presets
    noeta.client
    noeta.execution
    noeta.context | noeta.policies | noeta.tools | noeta.providers
    noeta.runtime | noeta.storage | noeta.guards | noeta.observers | noeta.read_models
    noeta.agent.registry
    noeta.agent.spec
    noeta.core
    noeta.protocols
exhaustive = false
ignore_imports =
    noeta.core.engine -> noeta.runtime.tool

[importlinter:contract:protocols-isolation]
name = noeta.protocols must not import any other in-project module
type = forbidden
source_modules =
    noeta.protocols
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.guards
    noeta.observers
    noeta.agent

[importlinter:contract:core-uses-only-protocols]
name = noeta.core may only import noeta.protocols (no L2 deps)
type = forbidden
source_modules =
    noeta.core
forbidden_modules =
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.guards
    noeta.observers
    noeta.agent
ignore_imports =
    ; The Engine lazily imports ``noeta.runtime.tool.ToolRuntime`` only when
    ; the caller did not wire one explicitly. A runtime convenience, not a
    ; module-load-order dependency, but import-linter sees the string so we
    ; mark it as the intentional exception. The library-SDK refactor removed
    ; the old ``noeta.context.composer`` default — the kernel no longer reaches there.
    noeta.core.engine -> noeta.runtime.tool

[importlinter:contract:runtime-no-providers]
name = noeta.runtime must not import noeta.providers (issue 11)
type = forbidden
source_modules =
    noeta.runtime
forbidden_modules =
    noeta.providers

[importlinter:contract:sdk-core-not-presets]
name = SDK core must not import noeta.presets (presets is top-of-stack factory content, only consumers import it)
type = forbidden
source_modules =
    noeta.client
    noeta.execution
    noeta.context
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.presets

[importlinter:contract:sdk-core-not-builtins]
name = SDK core must not import noeta.builtins (built-in plugins are top-of-stack declarations reached only by ref; the loader imports them dynamically)
type = forbidden
source_modules =
    noeta.client
    noeta.execution
    noeta.context
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.builtins

[importlinter:contract:providers-only-protocols]
name = noeta.providers may only import noeta.protocols (issue 11)
type = forbidden
source_modules =
    noeta.providers
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.guards
    noeta.observers

[importlinter:contract:agent-only-protocols]
name = noeta.agent identity layer (spec/registry) may only import noeta.protocols (narrowed to the identity submodules — the rest of the noeta.agent namespace is product content)
type = forbidden
source_modules =
    noeta.agent.spec
    noeta.agent.registry
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.guards
    noeta.observers
    noeta.read_models

[importlinter:contract:guards-only-protocols]
name = noeta.guards may only import noeta.protocols (issue 18)
type = forbidden
source_modules =
    noeta.guards
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.providers

[importlinter:contract:observers-only-protocols]
name = noeta.observers may only import noeta.protocols (issue 19)
type = forbidden
source_modules =
    noeta.observers
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.guards

[importlinter:contract:read-models-isolated]
name = noeta.read_models may only import noeta.protocols + noeta.core.fold (CW5a)
type = forbidden
source_modules =
    noeta.read_models
forbidden_modules =
    noeta.runtime
    noeta.context
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.guards
    noeta.observers
    noeta.storage
    noeta.core
; ``noeta.core`` is forbidden wholesale so read_models cannot reach
; engine/wiring/observers; the ONE allowed core edge — the fold projection —
; is whitelisted precisely (CW5a P1: lock the boundary, don't leave core open).
ignore_imports =
    noeta.read_models.sessions -> noeta.core.fold

[importlinter:contract:storage-adapters-isolated]
name = production code talks to storage Protocols, never to InMemory adapters
type = forbidden
source_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.policies
    noeta.tools
    noeta.providers
    noeta.protocols
forbidden_modules =
    noeta.storage

[importlinter:contract:mcp-tools-boundary]
name = noeta.tools.mcp may import only noeta.protocols + noeta.tools helpers + stdlib (Phase 4.5 F2)
type = forbidden
source_modules =
    noeta.tools.mcp
forbidden_modules =
    noeta.core
    noeta.runtime
    noeta.context
    noeta.storage
    noeta.policies
    noeta.providers
    noeta.guards
    noeta.observers
    noeta.agent
